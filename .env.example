# ─── Environment ────────────────────────────────────────────
# Set to 'production' on your host (Vercel sets this automatically)
# In dev, unhandled errors include full stack traces in the server log.
NODE_ENV=development

# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── Token Refresh Interval ───────────────────────────────
# How often to refresh the Spotify token (minutes)
REFRESH_INTERVAL_MINUTES=30

# ─── Database (Turso / libSQL) ─────────────────────────
# Leave blank to use local embedded SQLite (data/soundtracks.db)
# Or set your Turso cloud credentials from app.turso.tech/cnf1g:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── TMDB (Optional for higher rate limits) ───────────────
TMDB_API_KEY=

# ─── Rate Limiting ─────────────────────────────────────────
# Set RATE_LIMIT_ENABLED=true in production to activate.
# Currently a no-op in dev — middleware is already wired into all /v1/* routes.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MIN=60

# ─── Cron Security ──────────────────────────────────────────
# Random secret to protect /api/cron-health-check from unauthorized triggers.
# Set this in Vercel's environment variables. Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── GitHub (optional — for remote token commits) ─────────
# If not set, tokens are still saved locally to tokens.json
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=your-username/your-tokens-repo
GITHUB_FILE_PATH=tokens.json
