# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── Token Refresh Interval ───────────────────────────────
# How often to refresh the Spotify token (minutes)
REFRESH_INTERVAL_MINUTES=30

# ─── Database (Turso / libSQL) ─────────────────────────
# Leave blank to use local embedded SQLite (data/soundtracks.db)
# Or set your Turso cloud credentials from app.turso.tech/cnf1g:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── TMDB (Optional for higher rate limits) ───────────────
TMDB_API_KEY=

# ─── GitHub (optional — for remote token commits) ─────────
# If not set, tokens are still saved locally to tokens.json
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=your-username/your-tokens-repo
GITHUB_FILE_PATH=tokens.json
